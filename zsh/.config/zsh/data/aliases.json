{
    "Basic": {
        "cat": "bat",
        "cl": "clear && printf \"\\e[3J\"",
        "en": "enigma",
        "man": "tldr",
        "pyglobalenv": "source ~/venv/bin/activate",
        "refresh": "source ~/.zshrc",
        "src": "source ~/.zshrc",
        "sudo": "sudo -E -s",
        "vi": "nvim",
        "vim": "nvim",
        "y": "yazi",
        "zshconf": "vim ~/.zshrc"
    },
    "File System": {
        "cd": "z",
        "la": "lsd -a",
        "ll": "lsd -l",
        "lla": "lsd -la",
        "ls": "eza --color"
    },
    "Git": {
        "g": "git",
        "ga": "git add",
        "gc": "git commit",
        "gcb": "git checkout -b",
        "gcm": "git commit -m",
        "gco": "git checkout",
        "gd": "git diff",
        "gds": "git diff --staged",
        "getrepo": "~/.config/zsh/getrepo.sh",
        "gi": "git init",
        "gl": "git log",
        "gls": "git log --show-signature",
        "gp": "git push",
        "gpl": "git pull",
        "gs": "git status"
    },
    "Git Worktree": {
        "gw": "git worktree",
        "gwl": "git worktree list",
        "gwr": "git worktree remove"
    },
    "Navigation": {
        "aeroconf": "z ~/.config/aerospace",
        "batconf": "z \"$(bat --config-dir)\"",
        "config": "z ~/.config",
        "desk": "z ~/Desktop",
        "dotfiles": "z ~/dotfiles",
        "down": "z ~/Downloads",
        "ghosttyconf": "z ~/.config/ghostty",
        "gitconf": "z ~/.config/git",
        "home": "z ~",
        "hyprconf": "z ~/.config/hypr",
        "kittyconf": "z ~/.config/kitty",
        "ohmyzsh": "z ~/.oh-my-zsh",
        "proj": "z ~/projects",
        "shellconf": "z ~/.config/zsh",
        "sketchyconf": "z ~/.config/sketchybar",
        "starconf": "z ~/.config/starship",
        "swayconf": "z ~/.config/swaync",
        "tmuxconf": "z ~/.config/tmux",
        "vimconf": "z ~/.config/nvim",
        "wayconf": "z ~/.config/waybar",
        "wezconf": "z ~/.config/wezterm",
        "yaziconf": "z ~/.config/yazi"
    }
}