/* ~/.config/rofi/monitor-menu.rasi */
/* Based on bluetooth-menu.rasi but with message support */

* {
    /* Catppuccin Mocha Palette */
    background:       #1E1D2F; /* Base */
    background-alt:   #181926; /* Crust */
    foreground:       #CDD6F4; /* Text */
    selected:         #89B4FA; /* Blue */
    urgent:           #F38BA8; /* Red */

    font:             "JetBrains Mono Nerd Font 14";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    background-color: @background;
    border:           1px;
    border-color:     @selected;
    border-radius:    12px;
    width:            600px;
    location:         center;
    anchor:           center;
    padding:          20px;
}

mainbox {
    children:   [ "inputbar", "listview", "message" ];
    spacing:    15px;
}

inputbar {
    children:         [ "prompt", "entry" ];
    padding:          8px 12px;
    background-color: @background-alt;
    border-radius:    8px;
}

prompt {
    background-color: inherit;
    text-color:       @selected;
    padding:          0px 5px 0px 0px;
}

entry {
    background-color: inherit;
    placeholder:      "Search...";
    placeholder-color: @foreground;
}

listview {
    margin:           10px 0 0 0;
    lines:            5;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
}

element {
    padding:          10px;
    border-radius:    8px;
}

element-icon {
    size:             1.5em;
    margin:           0 15px 0 0;
    vertical-align:   0.5;
}

element-text {
    vertical-align: 0.5;
}

element selected {
    background-color: @selected;
    text-color:       @background;
}

message {
    padding:          10px;
    background-color: @background-alt;
    border-radius:    8px;
    text-color:       @foreground;
}
