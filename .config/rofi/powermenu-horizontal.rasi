/* ~/.config/rofi/powermenu-horizontal.rasi (Version 3 - Corrected) */

* {
    background:       #1e1e2e;
    background-alt:   #181825;
    foreground:       #cdd6f4;
    selected:         #f38ba8; /* Power button color */

    font:             "JetBrains Mono Nerd Font Bold 16";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    background-color: @background;
    border:           2px;
    border-color:     @background-alt;
    border-radius:    10px;
    width:            800px; /* A little more space for padding */
    location:         center;
    anchor:           center;
    padding:          25px;
}

/* We are not using an inputbar in this theme */
inputbar {
    enabled: false;
}

mainbox {
    children:   [ "message", "listview" ];
    spacing:    20px;
}

/* This is our new title bar */
message {
    background-color: @background-alt;
    border-radius:    10px;
    padding:          10px;
    text-color:       @selected; /* Use the highlight color for the title */
}

listview {
    layout:     horizontal;
    columns:    4;
    lines:      1;
    spacing:    20px;
}

element {
    background-color: @background-alt;
    border:           0px; /* No border by default */
    border-radius:    10px;
    padding:          30px 15px;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    horizontal-align: 0.5;
    vertical-align:   0.5;
}

element selected {
    background-color: @selected;
    text-color:       @background-alt;
}
