/* ~/.config/rofi/catppuccin-power.rasi */

* {
    background-color:   #1e1e2e;
    text-color:         #cdd6f4;
    font:               "JetBrains Mono Bold 16px";
}

window {
    /* FIX: Using 8-digit hex for transparency instead of rgba() */
    background-color:   #E51e1e2e;
    /* FIX: Splitting the border property for compatibility */
    border:             2px;
    border-color:       #11111b;
    width:              500px;
    height:             300px;
    border-radius:      15px;
}

mainbox {
    children:           [ inputbar, listview ];
}

inputbar {
    padding:            15px;
    children:           [ prompt ];
    border-radius:      10px;
    background-color:   #181825;
}

prompt {
    text-color:         #89b4fa;
}

listview {
    padding:            10px;
    lines:              4;
}

element {
    padding:            15px;
    border-radius:      10px;
}

element.selected {
    background-color:   #fab387;
    text-color:         #11111b;
}
