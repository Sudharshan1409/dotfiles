/* ~/.config/rofi/powermenu-vertical.rasi */

* {

    /* Catppuccin Mocha Palette */

    background:       #1E1D2F; /* Base */

    background-alt:   #181926; /* Crust */

    foreground:       #CDD6F4; /* Text */

    selected:         #89B4FA; /* Blue */

    urgent:           #F38BA8; /* Red */



    font:             "JetBrains Mono Nerd Font 16"; /* Non-bold for a lighter feel */

    background-color: transparent;

    text-color:       @foreground;

}



window {

    background-color: @background;

    border:           1px;

    border-color:     @selected;

    border-radius:    10px;

    width:            600px;

    location:         center;

    anchor:           center;

    padding:          20px;

}



mainbox {

    children:   [ "message", "listview" ];

    spacing:    15px;

}



message {

    background-color: @background-alt;

    border-radius:    10px;

    padding:          10px;

    horizontal-align: 0.5;

}



inputbar {

    enabled: false;

}



listview {

    layout:     vertical;

    columns:    1;

    lines:      2;

    spacing:    15px;

}



element {

    background-color: @background-alt;

    border:           2px;

    border-color:     @background-alt;

    border-radius:    10px;

    padding:          15px;

}



element-text {

    background-color: inherit;

    text-color:       inherit;

    horizontal-align: 0.5;

}







element selected {

    background-color: @selected;

    text-color:       @background; /* Invert text for readability */

    border-color:     @selected;

}
