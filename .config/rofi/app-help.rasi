/*
 * Rofi Theme for App-Specific Help
 * Catppuccin Mocha color scheme
 */

configuration {
    show-icons: false;
    disable-history: true;
}

* {
    bg: #1e1e2e;
    bg-alt: #313244;
    fg: #cdd6f4;
    selected: #89b4fa;
    selected-bg: #89b4fa;
    selected-fg: #1e1e2e;
    border-color: #89b4fa;
    
    background-color: @bg;
    text-color: @fg;
    font: "JetBrains Mono 10";
}

window {
    width: 700;
    height: 650;
    border: 2px;
    border-color: @border-color;
    border-radius: 10px;
    padding: 15px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    orientation: vertical;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px 15px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @selected;
    font: "JetBrains Mono Nerd Font 16";
    str: "❓ ";
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "App shortcuts...";
    placeholder-color: #6c7086;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 25;
    spacing: 2px;
    padding: 5px 0px;
    border: 0px;
    scrollbar: true;
}

scrollbar {
    background-color: @bg-alt;
    handle-color: @selected;
    handle-width: 6px;
    border-radius: 3px;
}

element {
    background-color: transparent;
    padding: 4px 12px;
    border-radius: 4px;
    spacing: 8px;
}

element selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "JetBrains Mono 10";
}
