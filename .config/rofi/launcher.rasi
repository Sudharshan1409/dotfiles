/* ~/.config/rofi/launcher.rasi */
/* Catppuccin Mocha Theme */

* {
    /* Colors from your hyprland config */
    background:     #1E1D2F; /* Base */
    background-alt: #181926; /* Crust */
    foreground:     #CDD6F4; /* Text */
    selected:       #89B4FA; /* Blue */
    urgent:         #F38BA8; /* Red */

    font:             "JetBrains Mono Nerd Font Bold 16";
    background-color: @background;
    text-color:       @foreground;
}

window {
    transparency:     "real";
    background-color: @background-alt;
    border:           2px;
    border-color:     @selected;
    border-radius:    10px;
    width:            600px;
    height:           500px;
    location:         center;
    anchor:           center;
}

mainbox {
    background-color: @background-alt;
    children:         [ "inputbar", "listview" ];
    spacing:          15px;
    padding:          15px;
}

inputbar {
    background-color: @background;
    border:           1px;
    border-color:     @background;
    border-radius:    10px;
    children:         [ "prompt", "entry" ];
    spacing:          10px;
    padding:          10px;
}

prompt {
    background-color: inherit;
    enabled:          true;
    text-color:       @selected;
}

entry {
    background-color: inherit;
    placeholder:      "Search Apps...";
    placeholder-color: @foreground;
}

listview {
    background-color: @background-alt;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    lines:            8;
    spacing:          10px;
}

element {
    background-color: @background-alt;
    border-radius:    10px;
    padding:          8px 12px;
}

element-icon {
    size: 1.5em; /* Adjust icon size if needed */
    vertical-align: 0.5;
    margin: 0px 10px 0px 0px;
}

element-text {
    vertical-align: 0.5;
}

element selected {
    background-color: @selected;
    text-color:       @background-alt;
}

element selected urgent {
    background-color: @urgent;
    text-color:       @background-alt;
}

element normal urgent {
    background-color: @urgent;
    text-color:       @background-alt;
}
