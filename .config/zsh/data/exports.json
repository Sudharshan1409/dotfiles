{
    "General": {
        "bat_theme": {
            "os": "any",
            "type": "variable",
            "value": "tokyonight_night",
            "var_name": "BAT_THEME"
        },
        "npm_global_path": {
            "os": "any",
            "type": "path",
            "value": "~/.npm-global/bin",
            "var_name": "PATH"
        }
    },
    "System (Linux)": {
        "Flatpak": {
            "os": "Linux",
            "type": "variable",
            "value": "/var/lib/flatpak/exports/share:/home/enigma/.local/share/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}",
            "var_name": "XDG_DATA_DIRS"
        },
        "brew_shellenv_linux": {
            "os": "Linux",
            "type": "eval",
            "value": "/home/linuxbrew/.linuxbrew/bin/brew shellenv",
            "var_name": ""
        },
        "ssh_add_linux": {
            "os": "Linux",
            "type": "run",
            "value": "ssh-add ~/.ssh/id_ed25519 > /dev/null 2>&1",
            "var_name": ""
        },
        "tmux_path_linux": {
            "os": "Linux",
            "type": "variable",
            "value": "/home/linuxbrew/.linuxbrew/bin/tmux",
            "var_name": "TMUX_PATH"
        }
    },
    "System (any)": {
        "ssh_agent": {
            "os": "any",
            "type": "eval",
            "value": "ssh-agent -s | grep '^SSH_'",
            "var_name": ""
        }
    },
    "System (macOS)": {
        "brew_shellenv_mac": {
            "os": "Darwin",
            "type": "eval",
            "value": "/opt/homebrew/bin/brew shellenv",
            "var_name": ""
        },
        "ssh_add_mac": {
            "os": "Darwin",
            "type": "run",
            "value": "ssh-add --apple-use-keychain ~/.ssh/id_ed25519 > /dev/null 2>&1",
            "var_name": ""
        },
        "tmux_path_mac": {
            "os": "Darwin",
            "type": "variable",
            "value": "/opt/homebrew/bin/tmux",
            "var_name": "TMUX_PATH"
        }
    }
}