{
    // #######################################################################################
    // #  General Bar Configuration                                                          #
    // #######################################################################################
    "layer": "top",
    "position": "top",
    "height": 50,
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    // #######################################################################################
    // #  Module Layout (Weather Removed)                                                    #
    // #######################################################################################
    "modules-left": [
        "clock",
        "hyprland/window",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "custom/mediaplayer"
    ],
    "modules-right": [
        "custom/network",
        "tray",
        "custom/bluetooth",
        "custom/cpu",
        "custom/memory",
        "battery",
        "backlight",
        "pulseaudio",
        "pulseaudio#microphone",
        "custom/power",
        "custom/swaync"
    ],
    // #######################################################################################
    // #  Left Modules Configuration                                                         #
    // #######################################################################################
    // THIS IS YOUR ORIGINAL, STABLE CLOCK CONFIGURATION, RESTORED
    "clock": {
        "format": "{:%H:%M}  ",
        "format-alt": "{:%A, %B %d, %Y (%R)}  ",
        "tooltip-format": "{calendar}"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 25,
        "tooltip": true
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "show-special": true,
        "sort-by-number": true,
        "persistent_workspaces": {}
    },
    // #######################################################################################
    // #  Center Module Configuration                                                        #
    // #######################################################################################
    "custom/mediaplayer": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 30,
        "exec": "playerctl -a metadata --format '{\"text\": \"{{markup_escape(artist)}} - {{markup_escape(title)}}\", \"tooltip\": \"<b>Player:</b> {{playerName}} | <b>Artist:</b> {{markup_escape(artist)}} | <b>Title:</b> {{markup_escape(title)}} | <b>Album:</b> {{markup_escape(album)}} | <b>Track:</b> {{xesam:trackNumber}} | <b>Duration:</b> {{duration(mpris:length)}}\", \"alt\": \"{{status}}\", \"class\": \"{{status}}\"}' -F",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },
    // #######################################################################################
    // #  Right Modules Configuration                                                        #
    // #######################################################################################
    "custom/network": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/waybar/scripts/network-manager.sh",
        "on-click": "~/.config/waybar/scripts/toggle-wifi.sh",
        "on-click-right": "~/.config/waybar/scripts/rofi-wifi-menu.sh",
        "tooltip": true
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    },
    "custom/bluetooth": {
        "format": "{}",
        "return-type": "json",
        "interval": 5,
        "exec": "~/.config/waybar/scripts/bluetooth-manager.sh",
        "on-click": "~/.config/waybar/scripts/toggle-bluetooth.sh",
        "on-click-right": "~/.config/waybar/scripts/launch_bluetooth.sh"
    },
    "custom/cpu": {
        "format": "󰾆 {}%",
        "interval": 5,
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "on-click": "kitty htop",
        "states": {
            "critical": 90
        }
    },
    "custom/memory": {
        "return-type": "json",
        "format": "{}",
        "interval": 30,
        "exec": "~/.config/waybar/scripts/memory.sh",
        "on-click": "kitty htop"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 40,
            "critical": 30
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ]
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl -q set 1%-",
        "on-scroll-down": "brightnessctl -q set 1%+"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": false,
        "format-muted": " Muted",
        "on-click": "pamixer -t",
        "on-scroll-up": "~/.config/waybar/scripts/volume-control.sh down",
        "on-scroll-down": "~/.config/waybar/scripts/volume-control.sh up",
        "scroll-step": 100
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " Muted",
        "on-click": "pamixer --default-source -t",
        "on-scroll-up": "~/.config/waybar/scripts/mic-control.sh down",
        "on-scroll-down": "~/.config/waybar/scripts/mic-control.sh up",
        "scroll-step": 5
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },
    "custom/swaync": {
        "format": "󰂚",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/swaync-client.sh"
    }
}
