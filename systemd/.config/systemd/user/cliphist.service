[Unit]
Description=Wayland Clipboard History Watcher (cliphist)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"; exec wl-paste --watch cliphist store'
Restart=always
RestartSec=1

[Install]
WantedBy=graphical-session.target
