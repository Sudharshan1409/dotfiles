/*
 * Rofi Theme for Exit Hyprland Confirmation
 * Catppuccin Mocha — destructive action (red accent)
 */

configuration {
    show-icons: false;
    disable-history: true;
}

* {
    bg:          #1e1e2e;
    bg-alt:      #313244;
    fg:          #cdd6f4;
    red:         #f38ba8;
    green:       #a6e3a1;
    subtext:     #a6adc8;

    background-color: @bg;
    text-color:       @fg;
    font:             "JetBrains Mono 12";
}

window {
    width:         420px;
    border:        2px;
    border-color:  @red;
    border-radius: 12px;
    padding:       20px;
    background-color: @bg;
    location:      center;
    anchor:        center;
}

mainbox {
    background-color: transparent;
    orientation:      vertical;
    spacing:          15px;
    children:         [ message, listview ];
}

message {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          14px;
    text-color:       @fg;
}

textbox {
    background-color: transparent;
    text-color:       @fg;
    horizontal-align: 0.5;
    font:             "JetBrains Mono Nerd Font 13";
}

inputbar {
    enabled: false;
}

listview {
    background-color: transparent;
    columns:          2;
    lines:            1;
    spacing:          12px;
    padding:          0px;
    border:           0px;
    fixed-height:     true;
}

element {
    background-color: @bg-alt;
    padding:          14px;
    border-radius:    8px;
    border:           2px;
    border-color:     @bg-alt;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    font:             "JetBrains Mono Nerd Font 13";
}

element selected {
    background-color: @red;
    text-color:       @bg;
    border-color:     @red;
}

element normal.normal {
    text-color: @subtext;
}
