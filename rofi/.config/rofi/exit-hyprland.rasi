/*
 * Rofi Theme for Exit Hyprland Confirmation
 * Catppuccin Mocha — destructive action (red accent)
 */

@import "~/.local/state/caelestia/theme/rofi-colors.rasi"

configuration {
    show-icons: false;
    disable-history: true;
}

* {
    bg:          @m3-bg;
    bg-alt:      @m3-surface;
    fg:          @m3-fg;
    red:         @m3-error;
    green:       @m3-success;
    subtext:     @m3-fg-muted;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    width:         420px;
    border:        2px;
    border-color:  @red;
    border-radius: 16px;
    padding:       20px;
    background-color: @bg;
    location:      center;
    anchor:        center;
}

mainbox {
    background-color: transparent;
    orientation:      vertical;
    spacing:          15px;
    children:         [ message, listview ];
}

message {
    background-color: @bg-alt;
    border-radius:    10px;
    padding:          14px;
    text-color:       @fg;
}

textbox {
    background-color: transparent;
    text-color:       @fg;
    horizontal-align: 0.5;
    font:             "JetBrains Mono Nerd Font 13";
}

inputbar {
    enabled: false;
}

listview {
    background-color: transparent;
    columns:          2;
    lines:            1;
    spacing:          12px;
    padding:          0px;
    border:           0px;
    fixed-height:     true;
}

element {
    background-color: @bg-alt;
    padding:          14px;
    border-radius:    8px;
    border:           2px;
    border-color:     @bg-alt;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    horizontal-align: 0.5;
    font:             "JetBrains Mono Nerd Font 13";
}

element selected {
    background-color: @red;
    text-color:       @m3-on-error;
    border-color:     @red;
}

element normal.normal {
    text-color: @subtext;
}
