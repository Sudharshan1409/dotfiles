/*
 * Rofi Theme for Calculator
 * Catppuccin Mocha color scheme
 */

@import "~/.local/state/caelestia/theme/rofi-colors.rasi"

configuration {
    show-icons: false;
    disable-history: false;
}

* {
    bg: @m3-bg;
    bg-alt: @m3-surface;
    fg: @m3-fg;
    selected: @m3-primary;
    selected-bg: @m3-primary;
    selected-fg: @m3-on-primary;
    border-color: @m3-primary;
    
    background-color: transparent;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font 12";
}

window {
    width: 520;
    height: 420;
    border: 2px;
    border-color: @border-color;
    border-radius: 16px;
    padding: 20px;
    background-color: @bg;
}

mainbox {
    background-color: transparent;
    orientation: vertical;
    spacing: 12px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg-alt;
    border-radius: 8px;
    padding: 12px 15px;
    spacing: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @selected;
    font: "JetBrains Mono Nerd Font 16";
    str: "🧮 ";
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "2+2, sqrt(16), 10*5...";
    placeholder-color: #6c7086;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 1;
    spacing: 4px;
    padding: 5px 0px;
    border: 0px;
    scrollbar: false;
}

element {
    background-color: @bg-alt;
    padding: 10px 14px;
    border-radius: 6px;
    spacing: 10px;
}

element selected {
    background-color: @selected-bg;
    text-color: @selected-fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: bold;
}
