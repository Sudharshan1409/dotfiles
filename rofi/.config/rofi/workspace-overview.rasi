/* ~/.config/rofi/workspace-overview.rasi */
/* Rofi theme for workspace overview */

* {
    /* Catppuccin Mocha Palette */
    background:       #1E1D2F;
    background-alt:   #181926;
    foreground:       #CDD6F4;
    selected:         #89B4FA;
    urgent:           #F38BA8;
    success:          #A6E3A1;

    font:             "JetBrains Mono Nerd Font 14";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    background-color: @background;
    border:           2px;
    border-color:     @selected;
    border-radius:    16px;
    width:            900px;
    height:           600px;
    location:         center;
    anchor:           center;
    padding:          25px;
}

mainbox {
    children:   [ "inputbar", "listview" ];
    spacing:    20px;
}

/* --- Input Bar --- */
inputbar {
    children:         [ "prompt", "entry" ];
    padding:          12px 16px;
    background-color: @background-alt;
    border-radius:    10px;
    spacing:          10px;
}

prompt {
    background-color: inherit;
    text-color:       @selected;
    font:             "JetBrains Mono Nerd Font 16";
}

entry {
    background-color: inherit;
    placeholder:      "Search workspaces or windows...";
    placeholder-color: rgba(205, 214, 244, 0.5);
    font:             "JetBrains Mono Nerd Font 14";
}

/* --- Results List --- */
listview {
    margin:           10px 0 0 0;
    lines:            15;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    spacing:          5px;
}

element {
    padding:          10px 15px;
    border-radius:    8px;
    spacing:          0px;
}

element-text {
    vertical-align:   0.5;
    font:             "JetBrains Mono Nerd Font 13";
}

/* Highlight the selected item */
element selected {
    background-color: @selected;
    text-color:       @background;
}

/* Workspace number styling */
element-text strong {
    text-color:       @success;
    font-weight:      bold;
}
