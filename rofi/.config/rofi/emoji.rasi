/* Rofi Theme for Emoji & Nerd Font Glyph Picker (Caelestia Material You) */
@import "~/.local/state/caelestia/theme/rofi-colors.rasi"

configuration {
    show-icons: false;
    disable-history: false;
}

* {
    background-color: transparent;
    text-color:       @m3-fg;
    font:             "JetBrainsMono Nerd Font 13";
}

window {
    background-color: @m3-bg;
    border:           2px;
    border-color:     @m3-primary;
    border-radius:    16px;
    width:            720px;
    height:           520px;
    location:         center;
    anchor:           center;
    padding:          20px;
}

mainbox {
    children:   [ "inputbar", "listview" ];
    spacing:    14px;
}

inputbar {
    children:         [ "prompt", "entry" ];
    padding:          12px 16px;
    background-color: @m3-surface;
    border-radius:    10px;
    spacing:          10px;
}

prompt {
    text-color: @m3-primary;
    font:       "JetBrainsMono Nerd Font 15";
    str:        "󰞅 ";
}

entry {
    placeholder:       "Search emojis & Nerd Font glyphs...";
    placeholder-color: @m3-fg-muted;
}

listview {
    lines:     10;
    columns:   1;
    spacing:   4px;
    scrollbar: true;
}

scrollbar {
    background-color: @m3-surface;
    handle-color:     @m3-primary;
    handle-width:     6px;
    border-radius:    3px;
}

element {
    padding:          10px 14px;
    border-radius:    8px;
    background-color: transparent;
}

element selected {
    background-color: @m3-primary;
    text-color:       @m3-on-primary;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}
