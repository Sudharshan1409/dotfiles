/* ~/.config/rofi/launcher-elegant.rasi */
/* A simple, elegant Catppuccin Mocha theme */

@import "~/.local/state/caelestia/theme/rofi-colors.rasi"

* {
    background:       @m3-bg;
    background-alt:   @m3-surface;
    foreground:       @m3-fg;
    selected:         @m3-primary;
    urgent:           @m3-error;

    font:             "JetBrainsMono Nerd Font 14";
    background-color: transparent;
    text-color:       @foreground;
}

window {
    background-color: @background;
    border:           2px;
    border-color:     @selected;
    border-radius:    16px;
    width:            1200px;
    height:           700px;
    location:         center;
    anchor:           center;
    padding:          20px;
}

mainbox {
    children:   [ "inputbar", "listview", "message" ];
    spacing:    15px;
}

/* --- Input Bar --- */
inputbar {
    children:         [ "prompt", "entry" ];
    padding:          8px 12px;
    background-color: @background-alt;
    border-radius:    8px;
}

prompt {
    background-color: inherit;
    text-color:       @selected;
    padding:          0px 5px 0px 0px; /* Space between icon and text */
}

entry {
    background-color: inherit;
    placeholder:      "Search...";
    placeholder-color: @foreground;
}

/* --- Results List --- */
listview {
    margin:           10px 0 0 0; /* Add space above the list */
    lines:            8;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
}

element {
    padding:          10px;
    border-radius:    8px;
    /* No background by default for a clean look */
}

element-icon {
    size:             1.8em;
    margin:           0 15px 0 0;
    vertical-align:   0.5;
}

element-text {
    vertical-align: 0.5;
}

/* Highlight the selected item */
element selected {
    background-color: @selected;
    text-color:       @m3-on-primary;
}

/* --- Message --- */
message {
    padding:          10px;
    background-color: @background-alt;
    border-radius:    8px;
    horizontal-align: 0.5; /* 0.5 for center alignment */
}