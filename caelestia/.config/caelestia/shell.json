{
    "appearance": {
        "transparency": {
            "base": 0.85,
            "enabled": true,
            "layers": 0.4
        }
    },
    "background": {
        "desktopClock": {
            "enabled": true,
            "position": "bottom-right",
            "scale": 1.0,
            "shadow": {
                "blur": 0.4,
                "enabled": true,
                "opacity": 0.7
            }
        },
        "enabled": true,
        "visualiser": {
            "autoHide": true,
            "blur": false,
            "enabled": true,
            "rounding": 1,
            "spacing": 1
        },
        "wallpaperEnabled": true
    },
    "bar": {
        "activeWindow": {
            "compact": true,
            "inverted": false
        },
        "clock": {
            "background": true,
            "showDate": true
        },
        "statusIcons": [
            {
                "enabled": true,
                "id": "lockStatus"
            },
            {
                "enabled": true,
                "id": "audio"
            },
            {
                "enabled": true,
                "id": "microphone"
            },
            {
                "enabled": false,
                "id": "kbLayout"
            },
            {
                "enabled": true,
                "id": "network"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "battery"
            }
        ],
        "tray": {
            "background": true,
            "compact": false,
            "recolour": true
        },
        "workspaces": {
            "maxWindowIcons": 6,
            "occupiedBg": true,
            "perMonitor": true,
            "showUnoccupied": true,
            "shown": 5
        }
    },
    "border": {
        "rounding": 20,
        "thickness": 6
    },
    "dashboard": {
        "enabled": true,
        "showClockSeconds": true,
        "showOnHover": true
    },
    "general": {
        "apps": {
            "audio": [
                "caelestia",
                "shell",
                "nexus",
                "open"
            ],
            "explorer": [
                "nautilus"
            ],
            "playback": [
                "xdg-open"
            ],
            "terminal": [
                "ghostty",
                "--gtk-single-instance=false",
                "--shell-integration-features=ssh-env"
            ]
        },
        "idle": {
            "inhibitWhenAudio": true,
            "inhibitWhenCharging": false,
            "lockBeforeSleep": true,
            "timeouts": [
                {
                    "enabled": true,
                    "idleAction": "lock",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 600
                },
                {
                    "enabled": true,
                    "idleAction": "dpms off",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 900
                }
            ]
        }
    },
    "launcher": {
        "enableDangerousActions": true,
        "maxShown": 10,
        "showOnHover": true,
        "vimKeybinds": true
    },
    "lock": {
        "enableFprint": true,
        "enableSessionControls": true,
        "enabled": true,
        "recolourLogo": true,
        "useWallpaper": true
    },
    "notifs": {
        "actionOnClick": true,
        "defaultExpireTimeout": 5000,
        "expire": true,
        "fullscreenExpireTimeout": 2000
    },
    "osd": {
        "enableBrightness": true,
        "enableMicrophone": true,
        "enabled": true,
        "hideDelay": 2000
    },
    "paths": {
        "wallpaperDir": "~/.config/backgrounds"
    },
    "services": {
        "weatherUnits": "Celsius"
    },
    "sidebar": {
        "dragThreshold": 80,
        "showOnHover": false
    },
    "utilities": {
        "enabled": true,
        "gameMode": {
            "options": {
                "animations:enabled": false,
                "decoration:blur:enabled": false,
                "decoration:rounding": 0,
                "decoration:shadow:enabled": false,
                "general:allow_tearing": true,
                "general:border_size": 1,
                "general:gaps_in": 0,
                "general:gaps_out": 0
            }
        },
        "toasts": {
            "nowPlaying": true
        }
    }
}
