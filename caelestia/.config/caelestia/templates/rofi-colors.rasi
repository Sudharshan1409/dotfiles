/* Auto-generated by Caelestia Material You dynamic theme */
* {
    m3-bg:                  rgba({{ surface.red }}, {{ surface.green }}, {{ surface.blue }}, 0.88);
    m3-bg-solid:            #{{ surface.hex }};
    m3-surface:             rgba({{ surfaceContainer.red }}, {{ surfaceContainer.green }}, {{ surfaceContainer.blue }}, 0.92);
    m3-surface-high:        rgba({{ surfaceContainerHigh.red }}, {{ surfaceContainerHigh.green }}, {{ surfaceContainerHigh.blue }}, 0.95);
    m3-fg:                  #{{ onSurface.hex }};
    m3-fg-muted:            #{{ onSurfaceVariant.hex }};
    m3-outline:             #{{ outlineVariant.hex }};
    m3-primary:             #{{ primary.hex }};
    m3-on-primary:          #{{ onPrimary.hex }};
    m3-primary-container:   #{{ primaryContainer.hex }};
    m3-on-primary-container:#{{ onPrimaryContainer.hex }};
    m3-secondary:           #{{ secondary.hex }};
    m3-tertiary:            #{{ tertiary.hex }};
    m3-error:               #{{ error.hex }};
    m3-on-error:            #{{ onError.hex }};
    m3-success:             #{{ success.hex }};
}
